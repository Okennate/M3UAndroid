 package com.m3u.data.parser.epg
 
 import com.m3u.data.database.model.Programme
-import java.time.ZonedDateTime
-import java.time.format.DateTimeFormatterBuilder
+import java.time.LocalDateTime
+import java.time.ZoneOffset
 
 data class EpgProgramme(
     val channel: String,
@@ -16,17 +16,44 @@ data class EpgProgramme(
     val categories: List<String>
 ) {
     companion object {
-        fun readEpochMilliseconds(time: String): Long = ZonedDateTime
-            .parse(time, EPG_DATE_TIME_FORMATTER)
-            .toInstant()
-            .toEpochMilli()
+        /**
+         * Parses an XMLTV timestamp: `YYYYMMDDhhmmss +hhmm`.
+         *
+         * XMLTV allows trailing components to be omitted (`YYYYMMDDhhmm`, `YYYYMMDD`, ...) and the
+         * offset to be missing, in which case UTC is assumed. Real-world feeds also write the
+         * offset without a space (`...+0100`), with a colon (`+01:00`), or as `Z`/`UTC`/`GMT`.
+         */
+        fun readEpochMilliseconds(time: String): Long {
+            val match = EPG_DATE_TIME_REGEX.matchEntire(time.trim())
+                ?: throw IllegalArgumentException("Unsupported XMLTV time: $time")
+            val groups = match.groupValues
+            fun part(index: Int, default: Int): Int =
+                groups[index].takeIf(String::isNotEmpty)?.toInt() ?: default
 
-        private val EPG_DATE_TIME_FORMATTER = DateTimeFormatterBuilder()
-            .appendPattern("yyyyMMddHHmmss")
-            .optionalStart()
-            .appendPattern(" Z")
-            .optionalEnd()
-            .toFormatter()
+            val offset = if (groups[8].isEmpty()) {
+                ZoneOffset.UTC
+            } else {
+                val sign = if (groups[8] == "-") -1 else 1
+                ZoneOffset.ofTotalSeconds(sign * (groups[9].toInt() * 3600 + groups[10].toInt() * 60))
+            }
+            return LocalDateTime
+                .of(
+                    part(1, 0),
+                    part(2, 1),
+                    part(3, 1),
+                    part(4, 0),
+                    part(5, 0),
+                    part(6, 0)
+                )
+                .toInstant(offset)
+                .toEpochMilli()
+        }
+
+        // 1:year 2:month 3:day 4:hour 5:minute 6:second 7:Z/UTC/GMT 8:sign 9:hh 10:mm
+        private val EPG_DATE_TIME_REGEX = Regex(
+            """^(\d{4})(\d{2})?(\d{2})?(\d{2})?(\d{2})?(\d{2})?\s*(?:(Z|UTC|GMT)|([+-])(\d{2}):?(\d{2}))?$""",
+            RegexOption.IGNORE_CASE
+        )
     }
 }
 
