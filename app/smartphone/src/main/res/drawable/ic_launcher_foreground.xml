<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- soft shadow under the disc -->
    <path
        android:pathData="M19,60 A35,35 0 1,0 89,60 A35,35 0 1,0 19,60 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="54" android:centerY="60" android:gradientRadius="35">
                <item android:offset="0" android:color="#B0000000" />
                <item android:offset="0.7" android:color="#66000000" />
                <item android:offset="1" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- bevelled rim -->
    <path
        android:pathData="M24.5,54 A29.5,29.5 0 1,0 83.5,54 A29.5,29.5 0 1,0 24.5,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="30" android:startY="26" android:endX="80" android:endY="84">
                <item android:offset="0" android:color="#6A6A72" />
                <item android:offset="0.5" android:color="#202024" />
                <item android:offset="1" android:color="#050506" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- black face with a soft highlight -->
    <path
        android:pathData="M26.4,54 A27.6,27.6 0 1,0 81.6,54 A27.6,27.6 0 1,0 26.4,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="45" android:centerY="41" android:gradientRadius="46">
                <item android:offset="0" android:color="#303036" />
                <item android:offset="0.5" android:color="#0C0C0E" />
                <item android:offset="1" android:color="#000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- touch of red on the lower rim -->
    <path
        android:pathData="M82.49,56.49 A28.6,28.6 0 0,1 41.91,79.92"
        android:strokeWidth="2.2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear" android:startX="82.49" android:startY="56.49" android:endX="41.91" android:endY="79.92">
                <item android:offset="0" android:color="#00FF3B4A" />
                <item android:offset="0.5" android:color="#FFFF3B4A" />
                <item android:offset="1" android:color="#00FF3B4A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- glossy highlight -->
    <group android:rotation="-18" android:pivotX="49" android:pivotY="38">
    <path
            android:pathData="M32,38 A17,8 0 1,0 66,38 A17,8 0 1,0 32,38 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear" android:startX="49" android:startY="30" android:endX="49" android:endY="46">
                    <item android:offset="0" android:color="#38FFFFFF" />
                    <item android:offset="1" android:color="#00FFFFFF" />
                </gradient>
            </aapt:attr>
        </path>
    </group>

    <!-- thickness of the play button -->
    <group android:translateX="1.5" android:translateY="2.4">
    <path
            android:pathData="M46.5,43 L46.5,65 L66,54 Z"
            android:strokeWidth="3.4"
            android:strokeLineJoin="round">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear" android:startX="46" android:startY="43" android:endX="68" android:endY="66">
                    <item android:offset="0" android:color="#8A8A92" />
                    <item android:offset="1" android:color="#2A2A30" />
                </gradient>
            </aapt:attr>
            <aapt:attr name="android:strokeColor">
                <gradient android:type="linear" android:startX="46" android:startY="43" android:endX="68" android:endY="66">
                    <item android:offset="0" android:color="#8A8A92" />
                    <item android:offset="1" android:color="#2A2A30" />
                </gradient>
            </aapt:attr>
        </path>
    </group>

    <!-- white play button -->
    <path
        android:pathData="M46.5,43 L46.5,65 L66,54 Z"
        android:strokeWidth="3.4"
        android:strokeLineJoin="round">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="46" android:startY="43" android:endX="67" android:endY="65">
                <item android:offset="0" android:color="#FFFFFF" />
                <item android:offset="1" android:color="#CFCFD6" />
            </gradient>
        </aapt:attr>
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear" android:startX="46" android:startY="43" android:endX="67" android:endY="65">
                <item android:offset="0" android:color="#FFFFFF" />
                <item android:offset="1" android:color="#CFCFD6" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
