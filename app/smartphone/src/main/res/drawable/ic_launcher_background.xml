<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#16161B"
                android:endColor="#060608"
                android:type="linear" />
        </shape>
    </item>
    <!-- faint red glow at the bottom -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.5"
                android:centerY="0.82"
                android:gradientRadius="55%p"
                android:startColor="#40E5232F"
                android:endColor="#00E5232F"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
