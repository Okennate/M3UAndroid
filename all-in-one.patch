+package com.m3u.core.foundation.architecture.preferences
+
+/**
+ * Presets for how much video is downloaded ahead of time.
+ * A bigger buffer rides out longer connection drops, but starts slower.
+ */
+@Target(
+    AnnotationTarget.CLASS,
+    AnnotationTarget.PROPERTY,
+    AnnotationTarget.VALUE_PARAMETER,
+    AnnotationTarget.TYPE
+)
+@Retention(AnnotationRetention.SOURCE)
+annotation class BufferSize {
+    companion object {
+        const val NORMAL = 0
+        const val MEDIUM = 1
+        const val LARGE = 2
+        const val MAX = 3
+
+        val ORDER = intArrayOf(NORMAL, MEDIUM, LARGE, MAX)
+
+        fun next(current: Int): Int =
+            ORDER[(ORDER.indexOf(current) + 1).mod(ORDER.size)]
+
+        /** min, max, buffer-for-playback, buffer-for-playback-after-stall (all in ms) */
+        fun durations(value: Int): IntArray = when (value) {
+            MEDIUM -> intArrayOf(25_000, 60_000, 3_000, 8_000)
+            LARGE -> intArrayOf(40_000, 100_000, 5_000, 12_000)
+            MAX -> intArrayOf(60_000, 150_000, 8_000, 15_000)
+            else -> intArrayOf(10_000, 20_000, 2_000, 5_000)
+        }
+    }
+}
+
+/** How long the app waits for a slow server before giving up. */
+@Target(
+    AnnotationTarget.CLASS,
+    AnnotationTarget.PROPERTY,
+    AnnotationTarget.VALUE_PARAMETER,
+    AnnotationTarget.TYPE
+)
+@Retention(AnnotationRetention.SOURCE)
+annotation class NetworkTimeout {
+    companion object {
+        /** Keep the app's normal client timeouts. */
+        const val DEFAULT = 0
+        const val LONG = 1
+        const val LONGER = 2
+
+        val ORDER = intArrayOf(DEFAULT, LONG, LONGER)
+
+        fun next(current: Int): Int =
+            ORDER[(ORDER.indexOf(current) + 1).mod(ORDER.size)]
+
+        /** connect and read timeouts in seconds, or null to keep the defaults */
+        fun seconds(value: Int): Pair<Long, Long>? = when (value) {
+            LONG -> 20L to 30L
+            LONGER -> 30L to 60L
+            else -> null
+        }
+    }
+}
+
+/** How many times a failed chunk download is retried before an error is shown. */
+@Target(
+    AnnotationTarget.CLASS,
+    AnnotationTarget.PROPERTY,
+    AnnotationTarget.VALUE_PARAMETER,
+    AnnotationTarget.TYPE
+)
+@Retention(AnnotationRetention.SOURCE)
+annotation class RetryCount {
+    companion object {
+        const val DEFAULT = 8
+        const val MORE = 12
+        const val MAX = 20
+
+        val ORDER = intArrayOf(DEFAULT, MORE, MAX)
+
+        fun next(current: Int): Int =
+            ORDER[(ORDER.indexOf(current) + 1).mod(ORDER.size)]
+    }
+}
+
+/** How far behind the live edge live channels are played, in seconds. */
+@Target(
+    AnnotationTarget.CLASS,
+    AnnotationTarget.PROPERTY,
+    AnnotationTarget.VALUE_PARAMETER,
+    AnnotationTarget.TYPE
+)
+@Retention(AnnotationRetention.SOURCE)
+annotation class LiveDelay {
+    companion object {
+        const val DEFAULT = 20
+        const val MORE = 30
+        const val MAX = 45
+
+        val ORDER = intArrayOf(DEFAULT, MORE, MAX)
+
+        fun next(current: Int): Int =
+            ORDER[(ORDER.indexOf(current) + 1).mod(ORDER.size)]
+    }
+}
