@@ -0,0 +1,46 @@
+package com.m3u.smartphone.ui.business.channel.components
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.DisposableEffect
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import androidx.media3.common.Player
+import androidx.media3.common.Tracks
+import androidx.media3.common.VideoSize
+import androidx.media3.exoplayer.ExoPlayer
+
+/**
+ * Returns a label such as "180 kbps · 240p" for the video that is currently playing,
+ * or null while nothing has been decoded yet (or for audio-only streams).
+ * When the stream does not declare a bitrate, only the resolution is returned ("240p").
+ */
+@Composable
+internal fun rememberVideoQualityLabel(player: Player?): String? {
+    var label by remember(player) { mutableStateOf<String?>(null) }
+    DisposableEffect(player) {
+        if (player == null) {
+            label = null
+            return@DisposableEffect onDispose {}
+        }
+        fun update() {
+            val format = (player as? ExoPlayer)?.videoFormat
+            val height = format?.height?.takeIf { it > 0 }
+                ?: player.videoSize.height.takeIf { it > 0 }
+            val kbps = format?.bitrate?.takeIf { it > 0 }?.div(1000)
+            label = height?.let { h ->
+                if (kbps != null) "$kbps kbps · ${h}p" else "${h}p"
+            }
+        }
+
+        val listener = object : Player.Listener {
+            override fun onVideoSizeChanged(videoSize: VideoSize) = update()
+            override fun onTracksChanged(tracks: Tracks) = update()
+        }
+        player.addListener(listener)
+        update()
+        onDispose { player.removeListener(listener) }
+    }
+    return label
+}
