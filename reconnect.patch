+    // "Only when failed": when playback fails (not when it ends), try again a few times.
+    @Volatile
+    private var failureReconnectAttempts = 0
+
+    @Volatile
+    private var failureReconnectUrl = ""
+
+    private fun reconnectAfterFailure(generation: Long) {
+        mainCoroutineScope.launch {
+            val mode = settings[PreferencesKeys.RECONNECT_MODE]
+            if (mode != ReconnectMode.RETRY && mode != ReconnectMode.RECONNECT) return@launch
+            val url = chain.url
+            if (url != failureReconnectUrl) {
+                failureReconnectUrl = url
+                failureReconnectAttempts = 0
+            }
+            if (failureReconnectAttempts >= 5) return@launch
+            failureReconnectAttempts++
+            val command = mediaCommand.value
+            delay(3_000L * failureReconnectAttempts) // wait longer after each failure
+            val replayGeneration = providerSessionState.beginGenerationIfCurrent(generation)
+                ?: return@launch
+            replay(
+                generation = replayGeneration,
+                command = command,
+            )
+        }
+    }
+
