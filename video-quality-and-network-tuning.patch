+/** Playback options chosen by the user in Settings. */
+private data class PlaybackTuning(
+    val videoQuality: Int,
+    val bufferSize: Int,
+    val networkTimeout: Int,
+    val retryCount: Int,
+    val liveDelaySeconds: Int,
+    val smoothQualitySwitching: Boolean,
+)
+
+/**
+ * Applies the user's video quality choice. [VideoQuality.AUTO] removes every cap.
+ * A video track picked manually from the player menu is cleared so the new
+ * quality takes effect.
+ */
+private fun TrackSelectionParameters.Builder.applyVideoQuality(
+    quality: Int
+): TrackSelectionParameters.Builder {
+    clearOverridesOfType(C.TRACK_TYPE_VIDEO)
+    if (quality == VideoQuality.AUTO) {
+        clearVideoSizeConstraints()
+        setMaxVideoBitrate(Int.MAX_VALUE)
+    } else {
+        setMaxVideoSize(Int.MAX_VALUE, quality)
+        setMaxVideoBitrate(VideoQuality.maxBitrate(quality) ?: Int.MAX_VALUE)
+    }
+    return this
+}
+
+private fun TrackSelectionParameters.withVideoQuality(quality: Int): TrackSelectionParameters =
+    buildUpon().applyVideoQuality(quality).build()
+
 fun VideoSize.toRect(): Rect {
     return Rect(0, 0, width, height)
 }
